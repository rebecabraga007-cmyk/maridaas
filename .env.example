VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Opcionais — quando definidos, os scripts são carregados de forma assíncrona
# e adiada (após o first paint), sem impactar o tempo de carregamento inicial.
VITE_META_PIXEL_ID=
VITE_GA_MEASUREMENT_ID=

# Mecanismo do login social. Deixe vazio para detecção automática:
#   - domínios *.lovable.app        -> broker da Lovable (/~oauth/initiate)
#   - qualquer outra hospedagem     -> OAuth nativo do Supabase
# Force com "lovable" ou "supabase" apenas se a detecção não servir
# (ex.: domínio customizado apontando para a hospedagem da Lovable).
# ATENÇÃO no modo supabase: ative Google/Apple em Authentication > Providers
# e inclua a URL do site na allowlist de redirect do projeto Supabase.
VITE_OAUTH_MODE=
